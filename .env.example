# LOGA3-Anmeldung (Pflicht)
PEP_USERNAME=
PEP_PASSWORD=

# Optional
# PEP_BASE_URL=https://harzklinikum.pi-asp.de
# PEP_OUTPUT=dienstplan.ics
# PEP_HEADLESS=true
# PEP_TIMEOUT_MS=60000
# PEP_TZ=Europe/Berlin

# Optional: Dienstplan in den Yuvomi-Schichtplan übertragen
# Der Token braucht Schreibrecht auf den Schichtplan.
# YUVOMI_BASE_URL=https://family.example.org
# YUVOMI_API_KEY=
# YUVOMI_USER_ID=4             # Haushaltsmitglied (GET /api/v1/schedule/household-members)
# YUVOMI_ABSENCES=neutral      # neutral = "Abwesend" | detail = Grund als Schichttyp | skip = weglassen
# YUVOMI_STATE_FILE=.pep-scraper-state.json   # merkt sich selbst angelegte Schichttypen
