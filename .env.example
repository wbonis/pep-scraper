# Optional: push roster into the Yuvomi shift schedule (Schichtplan)
# Token needs write access to calendar/schedule.
# YUVOMI_BASE_URL=https://family.example.org
# YUVOMI_API_KEY=
# YUVOMI_USER_ID=4             # household member id (GET /api/v1/schedule/household-members)
# YUVOMI_ABSENCES=neutral      # neutral = "Abwesend" | detail = reason as shift type | skip
